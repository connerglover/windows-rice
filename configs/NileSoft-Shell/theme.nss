theme
{
	name = "modern"

	view = view.small

	background
	{
		color = #272E33
		opacity = 100
		// effect = 2
	}

	item
	{
		opacity = 100
		radius = 6
		prefix = 1

		text
		{
			normal = #D3C6AA
			select = #A7C080
			normal-disabled = #859289
			select-disabled = #859289
		}

		back
		{
			select = #374145
			select-disabled = #2F383E
		}
	}

	font
	{
		size = 14
	 	name = "Segoe UI"
	 	weight = 1
	 	italic = 0
	 }

	border
	{
		enabled = true
		size = 1
		color = #475258
		opacity = 100
		radius = 10
	}

	shadow
	{
		enabled = true
		size = 8
		opacity = 15
		color = #1E2326
	}

	separator
	{
		size = 1
		color = #414B50
	}

	symbol
	{
		normal = #A7C080
		select = #A7C080
		normal-disabled = #A7C0807a
		select-disabled = #A7C0807a
	}

	image
	{
		enabled = false
		color = [#A7C080, #A7C080, #A7C080]
	}
}

    "terminal.ansiBrightBlack": "#7A8478",
    "terminal.ansiRed": "#E67E80",
    "terminal.ansiBrightRed": "#E67E80",
    "terminal.ansiGreen": "#A7C080",
    "terminal.ansiBrightGreen": "#A7C080",
    "terminal.ansiYellow": "#DBBC7F",
    "terminal.ansiBrightYellow": "#DBBC7F",
    "terminal.ansiBlue": "#7FBBB3",
    "terminal.ansiBrightBlue": "#7FBBB3",
    "terminal.ansiMagenta": "#D699B6",
    "terminal.ansiBrightMagenta": "#D699B6",
    "terminal.ansiCyan": "#83C092",
    "terminal.ansiBrightCyan": "#83C092",
    "terminal.ansiWhite": "#D3C6AA",
    "terminal.ansiBrightWhite": "#D3C6AA"
  },
  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#859289",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Keywords and storage",
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator"
      ],
      "settings": {
        "foreground": "#E69875"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Escapes and regex",
      "scope": [
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#83C092"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.other"
      ],
      "settings": {
        "foreground": "#D699B6"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "support.type.property-name",
        "meta.object-literal.key"
      ],
      "settings": {
        "foreground": "#7FBBB3"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace"
      ],
      "settings": {
        "foreground": "#D3C6AA"
      }
    },
    {
      "name": "Markdown headings",
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A7C080",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Markdown emphasis",
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D3C6AA",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Markdown strong",
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D3C6AA",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#7FBBB3",
        "fontStyle": "underline"
      }
    },
    {
      "name": "Added lines",
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#A7C080"
      }
    },
    {
      "name": "Removed lines",
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    },
    {
      "name": "Changed lines",
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#DBBC7F"
      }
    },
    {
      "name": "Invalid",
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E67E80"
      }
    }
  ],
  "semanticTokenColors": {
    "namespace": "#DBBC7F",
    "type": "#DBBC7F",
    "class": "#DBBC7F",
    "enum": "#DBBC7F",
    "interface": "#DBBC7F",
    "struct": "#DBBC7F",
    "typeParameter": "#DBBC7F",
    "parameter": "#D3C6AA",
    "variable": "#D3C6AA",
    "property": "#7FBBB3",
    "enumMember": "#D699B6",
    "function": "#A7C080",
    "method": "#A7C080",
    "macro": "#83C092",
    "keyword": "#E67E80",
    "number": "#D699B6",
    "string": "#A7C080",
    "comment": {
      "foreground": "#859289",
      "italic": true
    },
    "variable.readonly": "#D699B6"
  }
}
